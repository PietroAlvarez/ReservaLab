  "buildCommand": "npm --prefix soporte-suite run build",
  "outputDirectory": "soporte-suite/dist",
  "redirects": [
    {
      "source": "/reservas",
      "destination": "/reservas/index.html",
      "permanent": false
    }
  ]
}
